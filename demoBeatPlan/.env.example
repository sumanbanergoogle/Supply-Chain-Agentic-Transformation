# Environment configuration for BeatPulse AI (ITC TM&D)
# Copy to .env for local overrides; never commit .env

# Google Cloud / Vertex AI (ADC via `gcloud auth application-default login` or Cloud Run SA)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
BEATPULSE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Gemini Live (bidirectional voice + tool calling on Vertex AI)
BEATPULSE_LIVE_MODEL=gemini-3.8-live
BEATPULSE_LIVE_LOCATION=us-central1
BEATPULSE_LIVE_VOICE=Aoede
# Set to 1 to force deterministic/text fallback without Vertex Live
BEATPULSE_LIVE_OFFLINE=0

# Text / ADK Agent
BEATPULSE_TEXT_MODEL=gemini-3.8-flash
BEATPULSE_TEXT_LOCATION=global
# "vertex" (real Gemini via ADC) or "fake" (offline deterministic tool-grounded responder)
BEATPULSE_AGENT_LLM=vertex
BEATPULSE_DEFAULT_LANGUAGE=english

# Local ports
BACKEND_PORT=8002
FRONTEND_PORT=5180
